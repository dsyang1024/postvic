#!/bin/env csh
# This script routes output runoff and baseflow to streamflow for fluxes in the specified output directory
# FILENAME: RouteModelOutputs.csh
# usage: RouteModelOutputs.csh <scenario name> <outputtimestep>
# example: ./SCRIPTS/RouteModelOutputs.csh 1a 3


#SBATCH -A phig
#SBATCH --nodes=1
#SBATCH --mem-per-cpu=20G
#SBATCH --time=10:00:00
#SBATCH --job-name RouteFlow
module load gcc

#Move to routed outputs directory and remove old files

# if OUTPUTS_ROUTED_$1 exists, remove it and make new directory
if ( -d ./SCENARIOS/OUTPUTS_ROUTED_$1 ) then
    rm -r ./SCENARIOS/OUTPUTS_ROUTED_$1
    mkdir ./SCENARIOS/OUTPUTS_ROUTED_$1
else
    mkdir ./SCENARIOS/OUTPUTS_ROUTED_$1
endif


cd SCENARIOS/OUTPUTS_ROUTED_$1
# cd ls
rm *_discharge.txt


# OUTDIR is directory of the grid outputs
# set OUTDIR = '../OUTPUTS'
set OUTDIR = ".SCENARIOS/OUTPUTS_$1"
set ID = '23'
set SHED = 'Wabash'
set USGS = '03336000'


#Route data
/depot/phig/apps/GitHub/GIS-Routing-Model/bin/GisStreamflowRouting $OUTDIR $2 ../../ROUTING_FILES/"ws"$ID"_mask.txt" ../../ROUTING_FILES/"ws"$ID"_iuh.txt" ../../ROUTING_FILES/"area_ws"$ID".list" $SHED"_"$USGS"_discharge.txt"


#Copy over daily routed files to format to be processed by python
#awk -F- '{print $1, $2, $3;}' $SHED"_"$USGS"_discharge.txt" | awk 'BEGIN{print "Date,Discharge_cms";}{printf("%d-%02d-%02d,%f\n", $3,$1,$2,$4);}' >! "VIC_"$USGS".csv"